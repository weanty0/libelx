; elx.ll
declare i64 @syscall(i64, i64, i64, i64, i64, i64, i64)
declare void @exit(i64)
declare i64 @write(i64, ptr, i64)
declare i64 @read(i64, ptr, i64)
declare i32 @open(ptr, i32, i16)
declare i32 @close(i32)

; stdio.ll
declare i32 @fputc(i32, ptr)
declare i32 @fgetc(ptr)
declare i32 @putchar(i32)
declare i32 @getchar()
declare i32 @puts(ptr)
declare ptr @fopen(ptr, i32)
declare i32 @fclose(ptr)
declare i32 @fputs(ptr, ptr)
declare ptr @fgets(ptr, i64, ptr)

; string.ll
declare i64 @strlen(ptr)
declare ptr @strcpy(ptr, ptr)
declare i32 @strcmp(ptr, ptr)
declare ptr @strcat(ptr, ptr)
declare i32 @issuffix(ptr, ptr)
